{
	# Serve HTTP without redirecting to HTTPS while port 443 is blocked.
	# HTTPS still works once Lighthouse firewall allows 443 and certs are issued.
	auto_https disable_redirects
}

(mini_evvy) {
	handle_path /mini-evvy/api/* {
		reverse_proxy api:8080
	}

	handle /mini-evvy/* {
		root * /srv
		uri strip_prefix /mini-evvy
		try_files {path} /index.html
		file_server
	}
}

# Direct IP access (http://43.x.x.x/mini-evvy/)
:80 {
	import mini_evvy
}

evvy.fun, www.evvy.fun {
	import mini_evvy
}

kuma.evvy.fun {
	reverse_proxy uptime-kuma:3001
}
