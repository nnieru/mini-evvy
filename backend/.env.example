PORT=8080
DATABASE_URL=postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/eventmgmt?sslmode=require
MIGRATE_DATABASE_URL=postgresql://<user>:<password>@ep-xxx.<region>.aws.neon.tech/eventmgmt?sslmode=require
JWT_SECRET=some-long-random-dev-string
RESEND_API_KEY=
# After verifying evvy.fun in Resend → Domains (SPF/DKIM DNS records).
EMAIL_FROM=Mini Evvy <noreply@evvy.fun>

# Supabase Storage (S3-compatible). Create a public bucket e.g. email-banners.
# Dashboard: Storage → bucket → Public → Settings → S3 protocol → access keys.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=email-banners
S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/email-banners
GHCR_OWNER=nnieru